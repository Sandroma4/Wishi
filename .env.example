# Local SQLite. Resolve relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-secret"
# Set the canonical application URL; replace it with your HTTPS domain in production.
AUTH_URL="http://localhost:3000"
# Persistent directory outside the public web root (default: uploads/gifts).
UPLOAD_DIR="uploads/gifts"
# Local testing only: writes recovery emails to .local/mail, sends nothing.
# MAIL_TRANSPORT="file"
# EMAIL_OUTBOX_DIR=".local/mail"
# Optional private persistent directory for delivery status, without email content.
# EMAIL_STATUS_DIR=".local/email-status"
# Real email delivery: leave MAIL_TRANSPORT unset and configure Resend.
# Setup guide: docs/email-setup.md. Validate safely with npm run email:check.
# MAIL_FROM must use your verified Resend domain. No secrets should be shared in chat.
# RESEND_API_KEY=""
# MAIL_FROM="Wishi <hello@example.com>"
# Free Resend test alternative: only delivers to the Resend account email.
# MAIL_FROM="Wishi <onboarding@resend.dev>"
# Optional second copy: existing private external drive or cloud-synced directory.
# Must be an absolute path outside this project. The script refuses overwrites.
# BACKUP_EXTERNAL_DIR="E:/Wishi-backups"
